{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luki-tefinanza-staging",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luki-tefinanza-staging-db",
      "database_id": "3289e669-447a-4b74-bd3e-0a5ce80a4f82"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "luki-tefinanza-staging-files"
    }
  ]
}
