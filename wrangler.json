      "binding": "DB",
      "database_name": "luki-tefinanza-staging-db",
      "database_id": "3289e669-447a-4b74-bd3e-0a5ce80a4f82"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "luki-tefinanza-staging-files"
    }
  ],
  "vars": {
    "APP": "tefinanza",
    "ORIGIN": "https://luki-tefinanza-staging.sartori-luca65.workers.dev",
    "ACCESS_ISSUER": "https://proud-rain-876d.cloudflareaccess.com",
    "ACCESS_AUD": "422aa2299dc567319ac7f2b18ba53f8b32f19192492bf83f63f44756f500433a",
    "RELEASE_MODE": "private-live",
    "REPO": "sartoriluca65/tefinanza-app",
